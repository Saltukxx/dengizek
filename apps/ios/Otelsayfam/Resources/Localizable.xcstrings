    "Otelsayfam’da oteller fotoğraf galerisiyle değil, duraklı video turla tanıtılır.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Otelsayfam werden Hotels nicht per Fotogalerie, sondern per Videotour mit Stationen vorgestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Otelsayfam, hotels are presented with a video tour with stops, not a photo gallery."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Otelsayfam отели представлены не фотогалереей, а видеотуром с остановками."
          }
        }
      }
    },
    "Otelsayfam’da termal oteller fotoğraf galerisiyle değil, duraklı video turla tanıtılır.": {
