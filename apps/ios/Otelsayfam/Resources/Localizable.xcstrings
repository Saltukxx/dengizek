    "%lld geceden uzun konaklamalar için fiyatı ekibimiz bildirir; talep gönderin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Aufenthalte über %lld Nächte nennt unser Team den Preis; bitte senden Sie eine Anfrage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For stays longer than %lld nights our team quotes the price; please send a request."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для проживания дольше %lld ночей цену сообщит наша команда; отправьте запрос."
