    "En düşük fiyat": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedrigster Preis"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lowest price"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала дешёвые"
          }
        }
      }
    },
