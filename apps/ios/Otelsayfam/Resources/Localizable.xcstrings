    "Kayak otellerini fotoğraftan değil, odasından pistine duraklı video turla tanıyın.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lernen Sie Skihotels nicht über Fotos kennen, sondern per Videotour mit Stationen: vom Zimmer bis zur Piste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get to know ski hotels through a video tour with stops, from the room to the slopes, not through photos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знакомьтесь с горнолыжными отелями не по фото, а по видеотуру с остановками: от номера до трассы."
          }
        }
      }
    },
