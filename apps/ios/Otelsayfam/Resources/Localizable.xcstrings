            "value": "Слушаю…"
          }
        }
      }
    },
    "Diğer siteler fotoğraf gösterir. Biz oteli gezdiririz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Seiten zeigen Fotos. Wir führen Sie durchs Hotel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other sites show photos. We walk you through the hotel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие сайты показывают фото. Мы проводим вас по отелю."
          }
        }
      }
    },
    "Durak %lld / %lld": {
      "localizations": {
