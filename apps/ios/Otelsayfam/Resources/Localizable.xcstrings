            "value": "Эл. почта"
          }
        }
      }
    },
    "Ekibimiz %@ için talebinizi inceleyip %@ adresine dönüş yapacak. Talebiniz Kaydedilenler sekmesinde de duruyor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unser Team prüft Ihre Anfrage für %1$@ und antwortet an %2$@. Ihre Anfrage finden Sie auch im Tab „Gespeichert“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Our team will review your request for %1$@ and reply to %2$@. Your request is also kept in the Saved tab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наша команда рассмотрит ваш запрос по отелю %1$@ и ответит на %2$@. Запрос также сохранён во вкладке «Сохранённые»."
          }
        }
      }
    },
    "Ekibimiz talebinize e-postayla dönüş yapar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unser Team antwortet per E-Mail auf Ihre Anfrage."
