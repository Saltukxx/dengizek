    "Kaydettiğiniz otellerin gecelik başlayan fiyatı düşünce bildirim alırsınız.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden benachrichtigt, wenn der Ab-Preis pro Nacht eines gespeicherten Hotels sinkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll be notified when the starting nightly price of a saved hotel drops."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получите уведомление, когда минимальная цена за ночь в сохранённом отеле снизится."
          }
        }
      }
    },
