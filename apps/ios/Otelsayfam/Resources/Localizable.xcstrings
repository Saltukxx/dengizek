          "stringUnit": {
            "state": "translated",
            "value": "Check-out must be after check-in."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата выезда должна быть позже даты заезда."
          }
        }
      }
    },
    "Önerilen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfohlen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommended"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендуемые"
          }
        }
      }
    },
    "Örneğin \"Afyon\", \"Pamukkale\" ya da \"Oruçoğlu\".": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Beispiel „Afyon“, „Pamukkale“ oder „Oruçoğlu“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example “Afyon”, “Pamukkale” or “Oruçoğlu”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Например, «Afyon», «Pamukkale» или «Oruçoğlu»."
          }
        }
      }
    },
    "Özel talepler, sorular…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besondere Wünsche, Fragen…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Special requests, questions…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Особые пожелания, вопросы…"
          }
        }
      }
    },
    "İletişim": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontakt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакты"
          }
        }
      }
    },
    "İndirimden önce %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor Rabatt %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before discount %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До скидки %@"
          }
        }
      }
    },
    "İptal": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stornierung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellation"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        }
      }
    },
    "Şu anda ücret alınmaz. Fiyatı ve müsaitliği ekibimiz talebinize dönerken teyit eder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt wird nichts berechnet. Unser Team bestätigt Preis und Verfügbarkeit in der Antwort auf Ihre Anfrage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won’t be charged now. Our team confirms price and availability when replying to your request."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас оплата не взимается. Цену и наличие мест команда подтвердит в ответе на ваш запрос."
          }
        }
      }
    },
    "Şömineli oda": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaminzimmer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fireplace room"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Номер с камином"
          }
        }
      }
    },
    "Şömineli odaya geçiyorum.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich gehe zum Kaminzimmer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heading to the fireplace room."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перехожу к номеру с камином."
          }
        }
      }
    },
    "Şömineli odayı göster": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeig das Kaminzimmer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the fireplace room"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажи номер с камином"
          }
        }
      }
    },
    "“%@” ile eşleşen otel bulunamadı. Otel adını ya da şehri deneyin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Hotel passt zu „%@“. Versuchen Sie einen Hotelnamen oder eine Stadt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No hotel matches “%@”. Try a hotel name or city."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По запросу «%@» отелей не найдено. Попробуйте название отеля или город."
          }
        }
      }
    },
    "“Bilgi için arayın”": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Für Infos anrufen“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Call for information”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Звоните за информацией»"
          }
        }
      }
    },
    "“Kapalı havuz akşam kaça kadar açık?”": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bis wann hat das Hallenbad abends geöffnet?“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“How late is the indoor pool open?”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«До скольки вечером работает крытый бассейн?»"
          }
        }
      }
    },
    "“Kayak dolabı odaya yakın mı?”": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ist der Skispind in der Nähe des Zimmers?“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Is the ski locker near the room?”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Лыжный шкафчик рядом с номером?»"
          }
        }
      }
    },
    "“Plaja yürüyerek kaç dakika?”": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Wie viele Minuten zu Fuß zum Strand?“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“How many minutes’ walk to the beach?”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сколько минут пешком до пляжа?»"
          }
        }
      }
    }
  },
  "version": "1.0"
}
