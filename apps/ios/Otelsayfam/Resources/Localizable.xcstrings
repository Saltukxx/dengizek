    "Seçtiğiniz kişi sayısını alan oda yok. Kişi sayısını değiştirin ya da talep gönderin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zimmer passt zur gewählten Personenzahl. Ändern Sie die Personenzahl oder senden Sie eine Anfrage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No room fits the number of guests you selected. Change the number of guests or send a request."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет номера на выбранное число гостей. Измените число гостей или отправьте запрос."
          }
        }
      }
    },
    "Seçtiğiniz tarih, kişi ya da filtrelere uyan otel bulamadık. Birini kaldırıp tekrar bakın.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben kein Hotel gefunden, das zu Ihren Daten, Personen oder Filtern passt. Entfernen Sie eine Angabe und sehen Sie erneut nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t find a hotel matching your dates, guests or filters. Remove one and look again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы не нашли отелей по выбранным датам, гостям или фильтрам. Уберите одно из условий и посмотрите снова."
          }
        }
      }
    },
