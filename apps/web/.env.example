# Dengizek web — ortam değişkenleri örneği
# Kopyala: cp .env.example .env.local
# Production zorunluları src/env.ts içinde doğrulanır (eksikse boot'ta uyarır).

# --- Veritabanı -------------------------------------------------------------
# Postgres (VPS'te self-hosted Docker veya Neon). pgvector uzantısı gerekir.
# docker-compose.prod.yml içindeyken host adı "postgres" (compose servis adı)
# olmalı — src/lib/db/index.ts bunu otomatik algılayıp postgres.js sürücüsünü
# kullanır (Neon'un WebSocket sürücüsü yalnızca uzak host'larda devreye girer).
DATABASE_URL=postgresql://user:pass@localhost:5432/dengizek

# --- Auth -------------------------------------------------------------------
# Üret: openssl rand -base64 32  (production'da ZORUNLU)
AUTH_SECRET=

# --- Uygulama URL -----------------------------------------------------------
# E-posta linkleri, iCal feed ve webhook callback'lerinde kullanılır.
# Production'da ZORUNLU — yoksa linkler localhost'a çıkar.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI tur rehberi ---------------------------------------------------------
# Boşsa tur sohbeti 503 döner (uygulamanın geri kalanı çalışır)
OPENAI_API_KEY=
# İsteğe bağlı ayarlar (varsayılanlar kodda):
# AI_INQUIRY_INTENT_THRESHOLD=0.72
# Günlük bütçe tavanları (USD) — aşılırsa sohbet 503 döner:
# AI_DAILY_BUDGET_USD_PER_HOTEL=5
# AI_DAILY_BUDGET_USD_GLOBAL=50

# --- E-posta (Resend) -------------------------------------------------------
# Production'da zorunlu — outbox cron'u bunlarsız gönderemez.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# --- Cron (Vercel) ----------------------------------------------------------
# /api/internal/* rotalarını korur. Production'da ZORUNLU, yoksa cron'lar 401
# alır ve e-posta/medya temizliği + iCal senkronu hiç çalışmaz.
# Üret: openssl rand -hex 32
CRON_SECRET=

# Bunny pull zone "Advanced Token Authentication" güvenlik anahtarı.
# YOKSA video URL'leri imzasız sunulur — URL'i bilen herkes izler ve delivery
# ücreti size yazılır. Pull zone ayarlarından token auth açılıp anahtar buraya
# girilmelidir. TTL varsayılan 3600 sn.
BUNNY_CDN_TOKEN_KEY=
BUNNY_TOKEN_TTL_SEC=3600

# Sentry hata takibi — YOKSA tamamen devre dışı (no-op), CI/geliştirme etkilenmez.
# Yapılandırılmış JSON loglama her hâlükârda çalışır; Sentry ek katmandır.
SENTRY_DSN=
# Tarayıcı SDK'sı yalnızca public DSN tanımlıysa başlar.
NEXT_PUBLIC_SENTRY_DSN=
# Ortam ve release değerleri istemci/sunucu olaylarını aynı sürümde eşler.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# İki değer aynı git SHA'sı olmalı; SENTRY_RELEASE build eklentisi/sunucu içindir.
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
# İzleme örnekleme oranı (0 = kapalı, 0.1 = %10)
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Üçü birlikte tanımlanırsa production build source-map'leri Sentry'ye yükler
# ve yükleme sonrası istemciye sunulan build çıktısından source-map'leri siler.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Takvim günü saat dilimi — sezon/kampanya geçişleri buna göre hesaplanır.
# Ayarlanmazsa Europe/Istanbul kullanılır. Sunucu UTC'de çalıştığı için
# boş bırakmak Türkiye saatiyle 03:00'te gün değişmesine yol açmaz.
APP_TIMEZONE=Europe/Istanbul

# --- Bunny Stream medya -----------------------------------------------------
# Boşsa mock mod (demo video). Production'da hepsi zorunlu.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_WEBHOOK_SECRET=

# --- Görsel depolama (Cloudflare R2) ----------------------------------------
# R2_ENDPOINT yerine R2_ACCOUNT_ID de verilebilir.
# R2_PUBLIC_URL Cloudflare proxy'li bir domain olmalı (CDN cache için).
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# --- Ödeme (Stripe) ---------------------------------------------------------
# Bu fazda kapalıdır; checkout UI tamamlanmadan true yapmayın.
# true yapılacaksa STRIPE_* ikisi de zorunlu.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Geliştirme -------------------------------------------------------------
# DB yokken mock veri (production'da KULLANMAYIN)
# USE_MOCK_DATA=true
# Yayın snapshot'ı olmayan eski oteller için canlı tablo fallback'i
# SNAPSHOT_LEGACY_FALLBACK=false
