# Önceden (sınırlı kaynakla) derlenmiş standalone çıktıdan çalışma imajı.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
# Görsel optimizasyon önbelleği kalıcı birime bağlanır (docker-compose.yml);
# klasör nextjs kullanıcısına ait olmalı ki boş birim bu sahiplikle başlasın.
RUN mkdir -p /app/.next/cache && chown -R nextjs:nodejs /app/.next
COPY apps/web/public ./public
COPY --chown=nextjs:nodejs apps/web/.next/standalone ./
COPY --chown=nextjs:nodejs apps/web/.next/static ./.next/static
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
